# Configuration for Healthcare RAG API

# Provide your Google Gemini API Key below to enable live vector embeddings and RAG summaries.
# If left empty, the application runs in local Mock Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Database configuration
DATABASE_URL=sqlite:///./healthcare_rag.db

# Vector DB configuration
QDRANT_PATH=./qdrant_db
